generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  BUYER
  SUPPLIER
}

enum TriggerType {
  BID_RECEIVED
  ANY_RANK_CHANGE
  L1_CHANGE
}

enum EventType {
  BID_PLACED
  TIME_EXTENDED
  EXTENSION_CAPPED
}

model User {
  id      Int    @id @default(autoincrement())
  name    String
  company String
  role    Role

  rfqs   Rfq[]
  bids   Bid[]
  events AuctionEvent[]
}

model Rfq {
  id               Int         @id @default(autoincrement())
  refId            String      @unique
  name             String
  buyerId          Int
  bidStartAt       DateTime
  bidCloseAt       DateTime // original close, never changes
  currentCloseAt   DateTime // moves forward on extensions, capped at forcedCloseAt
  forcedCloseAt    DateTime
  pickupDate       DateTime    @db.Date
  triggerWindowMin Int // X
  extensionMin     Int // Y
  triggerType      TriggerType
  createdAt        DateTime    @default(now())

  buyer  User           @relation(fields: [buyerId], references: [id])
  bids   Bid[]
  events AuctionEvent[]
}

model Bid {
  id                 Int      @id @default(autoincrement())
  rfqId              Int
  supplierId         Int
  carrierName        String
  freightCharges     Decimal  @db.Decimal(12, 2)
  originCharges      Decimal  @db.Decimal(12, 2)
  destinationCharges Decimal  @db.Decimal(12, 2)
  totalAmount        Decimal  @db.Decimal(12, 2)
  transitTimeDays    Int
  quoteValidUntil    DateTime @db.Date
  createdAt          DateTime @default(now())

  rfq      Rfq            @relation(fields: [rfqId], references: [id])
  supplier User           @relation(fields: [supplierId], references: [id])
  events   AuctionEvent[]

  @@index([rfqId, supplierId, createdAt])
}

// Append-only activity log
model AuctionEvent {
  id         Int       @id @default(autoincrement())
  rfqId      Int
  type       EventType
  actorId    Int?
  bidId      Int?
  oldCloseAt DateTime?
  newCloseAt DateTime?
  reason     String
  createdAt  DateTime  @default(now())

  rfq   Rfq   @relation(fields: [rfqId], references: [id])
  actor User? @relation(fields: [actorId], references: [id])
  bid   Bid?  @relation(fields: [bidId], references: [id])

  @@index([rfqId, createdAt])
}
