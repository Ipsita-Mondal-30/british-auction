# Local: `docker compose up -d` at the repo root starts a matching Postgres.
# Render: set automatically from the Blueprint database.
# Supabase: use the direct (port 5432) or session-pooler connection string, with ?sslmode=require.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/british_auction"

# Comma-separated origins allowed by CORS and Socket.IO (your Vercel URL in production).
FRONTEND_ORIGIN="http://localhost:3000"

PORT=4000
